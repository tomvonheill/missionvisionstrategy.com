---
// One route for the Insights index and every post, so that zero visible posts emits zero pages.
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Post from '../../layouts/Post.astro'
import { getVisiblePosts } from '../../lib/insights'
import { formatDate } from '../../lib/posts.ts'
import '../../styles/prose.css'

export const getStaticPaths = (async () => {
  const posts = await getVisiblePosts()
  if (posts.length === 0) return []
  return [
    { params: { path: undefined }, props: { kind: 'index' as const, posts } },
    ...posts.map((post) => ({ params: { path: post.id }, props: { kind: 'post' as const, post } })),
  ]
}) satisfies GetStaticPaths

const props = Astro.props
const contact = {
  contactHeading: "Want to talk through an idea?",
  contactText: "If something here sparked a question about your organization, send us a note.",
}
const Content = props.kind === 'post' ? (await render(props.post)).Content : null
---
{props.kind === 'index' ? (
  <Base title="Insights | Mission Vision Strategy" description="Notes on strategy, planning, and operations for mission-driven organizations." current="insights" {...contact}>
    <section class="hero page-hero">
      <div class="wrap">
        <p class="eyebrow"><img class="star" src="/images/star.svg" alt="">Insights</p>
        <h1>Insights.</h1>
        <p class="lede">Notes on strategy, planning, and operations for mission-driven organizations.</p>
      </div>
      <div class="skyline"></div>
    </section>
    <section class="section">
      <div class="wrap">
        <ul class="post-list">
          {props.posts.map((p) => (
            <li>
              <a href={`/insights/${p.id}/`}>
                <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
                <h2>{p.data.title}{p.data.draft && <span class="draft-tag">Draft</span>}</h2>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </Base>
) : (
  <Post post={props.post} {...contact}>{Content && <Content />}</Post>
)}
