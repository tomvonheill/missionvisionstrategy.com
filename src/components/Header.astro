---
import { getVisiblePosts } from '../lib/insights'
import type { Current } from '../lib/nav.ts'
interface Props { current?: Current }
const { current } = Astro.props
const hasInsights = (await getVisiblePosts()).length > 0
const here = (page: Current) => (current === page ? 'page' : undefined)
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/"><img class="star" src="/images/star.svg" alt="">Mission Vision Strategy</a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        <li><a href="/services/" aria-current={here('services')}>Services</a></li>
        <li><a href="/approach/" aria-current={here('approach')}>Approach</a></li>
        {hasInsights && <li><a href="/insights/" aria-current={here('insights')}>Insights</a></li>}
        <li><a href="/#about">About</a></li>
        <li><a class="button" href="/#contact">Get in touch</a></li>
      </ul>
    </nav>
  </div>
</header>
