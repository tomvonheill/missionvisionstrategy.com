---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '../lib/posts.ts'
import Base from './Base.astro'

interface Props { post: CollectionEntry<'insights'>; contactHeading: string; contactText: string }
const { post, contactHeading, contactText } = Astro.props
const { title, description, pubDate, updatedDate, heroImage, heroAlt, draft } = post.data
---
<Base title={`${title} | Mission Vision Strategy`} description={description} current="insights"
      contactHeading={contactHeading} contactText={contactText} ogType="article">
  <article class="section post">
    <div class="wrap prose-wrap">
      <a class="back" href="/insights/">&larr; All insights</a>
      <p class="eyebrow"><img class="star" src="/images/star.svg" alt="">Insights{draft && <span class="draft-tag">Draft</span>}</p>
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <> &middot; Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
      </p>
      {heroImage && <Image class="post-hero" src={heroImage} alt={heroAlt ?? ''} widths={[720, 1440]} sizes="(max-width: 48rem) 100vw, 48rem" />}
      <div class="prose"><slot /></div>
      <a class="back" href="/insights/">&larr; All insights</a>
    </div>
  </article>
</Base>
